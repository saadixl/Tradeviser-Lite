# Optional: share analyses through a Firebase Realtime Database.
# Copy to .env.local and fill in your Firebase web app config. Without it, Tradeviser Lite
# keeps analyses in the browser only. Database rules: see README ("Shared analysis cache").
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
